{
  "name": "Motion AI",
  "version": "2.0.0",
  "color": {
    "accent": "#E53935",
    "ink": "#111111",
    "ink-soft": "#222222",
    "paper-center": "#ffffff",
    "paper-edge": "#c9cbd2",
    "bg-gradient": "radial-gradient(ellipse at 50% 38%, #ffffff 0%, #e4e5ea 75%, #c9cbd2 100%)",
    "card-dark": "linear-gradient(160deg, #2a2d35, #0b0c0f)",
    "card-light": "linear-gradient(160deg, #ffffff, #e2e3e8)",
    "card-warm": "linear-gradient(160deg, #ffb070, #E53935)",
    "paper-cool": "#f5f5f2",
    "forbidden": [
      "#000000",
      "#ffffff (pur)"
    ]
  },
  "font": {
    "display": "Anton, \"DejaVu Sans Condensed\", \"Arial Narrow\", sans-serif",
    "display-weight": 900,
    "mono": "\"Courier Prime\", \"Liberation Mono\", \"Courier New\", monospace",
    "body": "\"DejaVu Sans\", Arial, sans-serif",
    "google-fonts-link": "https://fonts.googleapis.com/css2?family=Anton&family=Courier+Prime&display=swap"
  },
  "size": {
    "title-vertical": "78px",
    "title-square": "64px",
    "mono-caption": "22px",
    "cta": "40px",
    "min-readable": "16px"
  },
  "radius": {
    "card": "40px",
    "button": "999px",
    "window": "16px"
  },
  "shadow": {
    "soft": "0 26px 40px -18px rgba(0,0,0,.30)",
    "lift": "0 40px 60px -20px rgba(0,0,0,.35)",
    "accent": "0 24px 40px -14px rgba(229,57,53,.55)"
  },
  "motion": {
    "ease-enter": "easeOutBack (rebond léger)",
    "ease-move": "easeOutCubic",
    "scene-fade": "0.3 s",
    "scene-min": "2 s",
    "scene-max": "4 s",
    "stagger": "0.12 s",
    "camera-drift": "scale 1.00 à 1.04, dérive de quelques pixels",
    "spring": "1 - exp(-4.5*x)",
    "text-reveal": "masque, translateY 105%, stagger 55 ms, rotation légère",
    "camera": "échelle logarithmique, un seul sens",
    "transition-families": [
      "inondation 0.35-0.45 s",
      "balayage 0.4-0.5 s",
      "iris 0.6 s",
      "fondu flouté 0.3-0.4 s"
    ],
    "surprise-every-s": 15,
    "hold-final-s": "2-3"
  },
  "format": {
    "vertical": [
      540,
      960
    ],
    "square": [
      720,
      720
    ],
    "landscape": [
      960,
      540
    ],
    "margin": "8%"
  },
  "captions": {
    "position": "centre horizontal, environ 38 % de la hauteur",
    "style": "majuscules, chasse fixe, espacement 0,15 em",
    "reveal": "mot par mot, sans glissement"
  }
}